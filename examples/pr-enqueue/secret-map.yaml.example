apiVersion: dekopon.dev/secret-map/v1alpha1
mapRevision: pr-enqueue-example
secrets:
  - drn: drn:com.xrl:secret:prod:github/org
    destinations: [api.github.com]
    source:
      kind: githubApp
      appId: 1000001
      installationId: 2000001
      privateKey: /run/dekopon-secrets/github-org-app.pem
    bindings:
      - id: github-org-enqueue
        capabilities: [gh.pull-request.enqueue]
        sink: httpBearer
        allowedHosts: [api.github.com]
        allowedMethods: [GET, POST]
        allowedPaths:
          - {match: segmentPrefix, path: /repos/dekopon-agents}
          - {match: exact, path: /graphql}
        maxInjections: 2
