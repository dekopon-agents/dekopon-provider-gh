apiVersion: dekopon.dev/secret-map/v1alpha1
mapRevision: pins-example
secrets:
  - drn: drn:com.xrl:secret:prod:github/xrl
    destinations: [api.github.com]
    source:
      kind: githubApp
      appId: 1000002
      installationId: 2000002
      privateKey: /run/dekopon-secrets/github-xrl-app.pem
      repositories: [rpi-homelab]
    bindings:
      - id: github-xrl-pin-update
        capabilities: [gh.pin.update]
        sink: httpBearer
        allowedHosts: [api.github.com]
        allowedMethods: [GET, POST, PUT]
        allowedPaths: [{match: segmentPrefix, path: /repos/xrl/rpi-homelab}]
        maxInjections: 24
      - id: github-xrl-pin-merge
        capabilities: [gh.pin.merge]
        sink: httpBearer
        allowedHosts: [api.github.com]
        allowedMethods: [GET, PUT]
        allowedPaths: [{match: segmentPrefix, path: /repos/xrl/rpi-homelab}]
        maxInjections: 32
